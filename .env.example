# ====================================================================
# TEMPLATE CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT CONFIGURATION TEMPLATE)
# Sao chép tệp này thành '.env' và cập nhật thông số mật khẩu / bí mật thực tế.
# ====================================================================

# 1. DATABASE CONFIGURATION (POSTGRESQL)
POSTGRES_DB=school_records
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_secure_postgres_password_2026

# 2. MINIO S3 OBJECT STORAGE CONFIGURATION
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_this_to_secure_minio_password_2026
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_this_to_secure_minio_password_2026
MINIO_BUCKET_NAME=school-records
MINIO_ENDPOINT=http://minio:9000

# 3. SECURITY & JWT CONFIGURATION
# Mã hóa chuỗi secret ngẫu nhiên tối thiểu 256-bit
JWT_SECRET=c2Nob29sLXJlY29yZHMtc3VwZXItc2VjcmV0LWtleS0xMjM0NTY3ODkwLWFiY2RlZi1naGlqaw==
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# 4. CORS SECURITY ORIGINS (Phân tách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1

# 5. NGROK TUNNEL (Tùy chọn - chỉ cần khi dùng remote access)
# Lấy authtoken miễn phí tại: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
# URL ngrok sẽ được gán sau khi tunnel khởi động (xem trong docker logs)
NGROK_URL=https://your-ngrok-url.ngrok-free.app
# CORS đặc biệt cho Ngrok - thêm NGROK_URL vào danh sách
CORS_ALLOWED_ORIGINS_NGROK=http://localhost,http://localhost:3000,http://127.0.0.1,https://your-ngrok-url.ngrok-free.app
